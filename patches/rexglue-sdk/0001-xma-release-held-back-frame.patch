+// Releases the frame that the start-padding realignment in Decode() is still
+// holding in carry_frame_.
+//
+// Decode() emits every frame one decode late: FFmpeg's samples run
+// kDecoderStartPadding ahead of the bitstream's numbering, so a frame is only
+// complete once the head of the next decoded block arrives. The hardware has no
+// such lag and writes every frame of the stream, the last one included. When
+// the input runs dry nothing completes the final frame, so a stream of N frames
+// came out N-1 frames long, and a guest that decodes a whole wave into memory
+// and waits for its full sample count spun forever. 565507FA hangs on its first
+// loading screen this way: it wants 30208 samples, the decoder delivered 29824.
+//
+// The missing kDecoderStartPadding samples would be the head of a block that
+// does not exist (the codec's overlap-add tail, which ff_xmaframes offers no
+// flush for), so they are written as silence. If the guest was only late with
+// its next buffer (an underrun), those padding samples become silence at the
+// seam, but the sample count still matches what the hardware produces.
+bool XmaContext::FlushCarry(const XMA_CONTEXT_DATA* data) {
+  if (!carry_valid_ || current_frame_remaining_subframes_ > 0) {
+    return false;
+  }
+
+  const size_t pad_bytes = kDecoderStartPadding * kBytesPerSample << data->is_stereo;
+  const size_t carry_bytes = (kBytesPerFrameChannel << data->is_stereo) - pad_bytes;
+  std::memcpy(raw_frame_.data(), carry_frame_.data(), carry_bytes);
+  std::memset(raw_frame_.data() + carry_bytes, 0, pad_bytes);
+
+  // Same bookkeeping as the carry branch in Decode(): the loop-end limit and
+  // loop-start skip recorded for this frame apply now that it is output.
+  current_frame_remaining_subframes_ = 4 << data->is_stereo;
+  loop_frame_output_limit_ = pending_output_limit_;
+  current_frame_remaining_subframes_ -=
+      std::min(pending_start_skip_, current_frame_remaining_subframes_);
+
+  carry_valid_ = false;
+  pending_output_limit_ = 0;
+  pending_start_skip_ = 0;
+  return true;
+}
