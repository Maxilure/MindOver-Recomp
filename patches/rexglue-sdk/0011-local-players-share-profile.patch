   void SaveSetting(UserProfile::Setting*);
 };
 
+// Local co-op (CrashMoM patch 0011): players 2-4 share player 1's profile.
+// A real 360 wants a profile signed in on every player's controller; a PC has
+// one profile. The app says which extra players are present (it has a device
+// playing as them); those then report player 1's profile (signed in, same
+// XUID and name, same profile settings), so player 2 can start the game or
+// join it, and every save stays in the one profile (saves are stored by the
+// profile's XUID, whichever player writes them). No callback (the default) =
+// player 1 only, as before.
+using LocalPlayerPresentFn = std::function<bool(uint32_t user_index)>;
+void SetLocalPlayerPresentCallback(LocalPlayerPresentFn callback);
+// Is user `user_index` (0-3) signed in? Player 1: the profile's state;
+// players 2-4: player 1 is signed in AND the app says they're present.
+bool IsLocalUserSignedIn(uint32_t user_index);
+// Bit N set = user N signed in.
+uint32_t SignedInUserMask();
+// The app's answer changed: tells the game (XN_SYS_SIGNINCHANGED, the
+// notification games rebuild their list of signed-in players on).
+void NotifyLocalPlayersChanged();
+
 }  // namespace xam
 }  // namespace system
 }  // namespace rex
