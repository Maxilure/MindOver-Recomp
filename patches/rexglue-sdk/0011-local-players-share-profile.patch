+// Local co-op: players 2-4 share player 1's profile (CrashMoM patch 0011,
+// see rex/system/xam/user_profile.h).
+namespace rex::system::xam {
+namespace {
+std::mutex g_local_players_mutex;
+LocalPlayerPresentFn g_local_player_present;
+}  // namespace
+
+void SetLocalPlayerPresentCallback(LocalPlayerPresentFn callback) {
+  std::lock_guard<std::mutex> lock(g_local_players_mutex);
+  g_local_player_present = std::move(callback);
+}
+
+bool IsLocalUserSignedIn(uint32_t user_index) {
+  auto* kernel_state = REX_KERNEL_STATE();
+  if (user_index >= 4 || !kernel_state || !kernel_state->user_profile() ||
+      kernel_state->user_profile()->signin_state() == 0) {
+    return false;
+  }
+  if (user_index == 0) {
+    return true;
+  }
+  LocalPlayerPresentFn present;
+  {
+    std::lock_guard<std::mutex> lock(g_local_players_mutex);
+    present = g_local_player_present;
+  }
+  return present && present(user_index);
+}
+
+uint32_t SignedInUserMask() {
+  uint32_t mask = 0;
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (IsLocalUserSignedIn(i)) {
+      mask |= 1u << i;
+    }
+  }
+  return mask;
+}
+
+void NotifyLocalPlayersChanged() {
+  if (auto* kernel_state = REX_KERNEL_STATE()) {
+    // XN_SYS_SIGNINCHANGED; the parameter = who is signed in now.
+    kernel_state->BroadcastNotification(0x0000000A, SignedInUserMask());
+  }
+}
+}  // namespace rex::system::xam
