--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -55,6 +55,19 @@
                     "For host renderers that draw the game themselves")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+// Mind over Recomp (patch 0013): next to a host renderer that draws the game
+// too (the port's dual mode), the emulated GPU can draw only every Nth frame:
+// the frames it draws are complete and exact, the ones in between are parsed
+// but neither drawn nor presented (the window keeps the last picture). The
+// emulated picture then moves at 1/N of the game's frame rate for 1/N of the
+// host GPU work. Read at every draw, so the port sets it back to 1 for the
+// frames an A/B photo captures.
+REXCVAR_DEFINE_INT32(draw_every_nth_frame, 1, "GPU",
+                     "Draw (and present) only every Nth frame: 1 = every frame, 2 = every "
+                     "second one (half the GPU work, the picture moves at half rate)")
+    .range(1, 4)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_STRING(readback_resolve, "none", "GPU",
                       "Controls CPU readback of render-to-texture resolve results.\n"
                       " none: Disable readback (default)\n"
@@ -971,9 +984,15 @@
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
 
   ++counter_;
+  ++frame_cycle_;  // patch 0013: the next frame
   return true;
 }
 
+bool CommandProcessor::CurrentFrameSkipped() const {
+  const int32_t every = REXCVAR_GET(draw_every_nth_frame);
+  return every > 1 && (frame_cycle_ % uint64_t(every)) != 0;
+}
