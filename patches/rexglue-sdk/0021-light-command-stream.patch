+bool CommandProcessor::RegisterHasSideEffects(uint32_t index) {
+  // Exactly the registers WriteRegister below does more than store (+ the
+  // ones outside the register file, kept in extended_register_values_).
+  return index >= RegisterFile::kRegisterCount ||
+         (index >= XE_GPU_REG_SCRATCH_REG0 && index <= XE_GPU_REG_SCRATCH_REG7) ||
+         index == XE_GPU_REG_COHER_STATUS_HOST || index == XE_GPU_REG_DC_LUT_RW_INDEX ||
+         index == XE_GPU_REG_DC_LUT_SEQ_COLOR || index == XE_GPU_REG_DC_LUT_PWL_DATA ||
+         index == XE_GPU_REG_DC_LUT_30_COLOR;
+}
+
+bool CommandProcessor::LightRegisterWrite(uint32_t index, uint32_t value) {
+  if (RegisterHasSideEffects(index)) {
+    return false;
+  }
+  // Volatile like the full path (the WAIT_REG_MEM loop reads it).
+  const_cast<volatile uint32_t&>(register_file_->values[index]) = value;
+  light_writes_pending_ = true;
+  return true;
+}
+
+bool CommandProcessor::LightRegisterRange(uint32_t start_index, const uint32_t* base,
+                                          uint32_t num_registers) {
+  if (!num_registers) {
+    return true;
+  }
+  const uint32_t end_index = start_index + num_registers - 1;
+  if (end_index >= RegisterFile::kRegisterCount) {
+    return false;
+  }
+  // Any range touching a side-effect register takes the per-register way
+  // (checked against the few of them, not per register).
+  if (start_index <= XE_GPU_REG_SCRATCH_REG7 && end_index >= XE_GPU_REG_SCRATCH_REG0) {
+    return false;
+  }
+  for (uint32_t special : {uint32_t(XE_GPU_REG_COHER_STATUS_HOST), uint32_t(XE_GPU_REG_DC_LUT_RW_INDEX),
+                           uint32_t(XE_GPU_REG_DC_LUT_SEQ_COLOR), uint32_t(XE_GPU_REG_DC_LUT_PWL_DATA),
+                           uint32_t(XE_GPU_REG_DC_LUT_30_COLOR)}) {
+    if (special >= start_index && special <= end_index) {
+      return false;
+    }
+  }
+  memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
+  light_writes_pending_ = true;
+  return true;
+}
