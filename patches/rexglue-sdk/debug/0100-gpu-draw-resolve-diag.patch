+// CRASHMOM-DIAG (temporary): per-frame draw logging.
+// CRASHMOM_DIAG_FRAMES="ms,ms,..." (ms since this library loaded): at the
+// first swap after each time, log every draw/resolve until the next swap.
+namespace rex::graphics::draw_util {
+extern std::atomic<bool> g_crashmom_diag_frame;
+}
+namespace {
+const auto crashmom_diag_t0 = std::chrono::steady_clock::now();
+std::vector<int64_t> CrashmomDiagTimes() {
+  std::vector<int64_t> out;
+  if (const char* env = std::getenv("CRASHMOM_DIAG_FRAMES")) {
+    std::string_view rest(env);
+    while (!rest.empty()) {
+      size_t comma = rest.find(',');
+      int64_t v = 0;
+      std::from_chars(rest.data(), rest.data() + std::min(comma, rest.size()), v);
+      out.push_back(v);
+      rest = comma == std::string_view::npos ? std::string_view() : rest.substr(comma + 1);
+    }
+  }
+  return out;
+}
+std::vector<int64_t> crashmom_diag_times = CrashmomDiagTimes();
+size_t crashmom_diag_next = 0;
+uint32_t crashmom_diag_frame_number = 0;
+// Called at every swap: ends the logged frame, maybe starts the next one.
+void CrashmomDiagOnSwap(uint32_t frontbuffer_ptr, uint32_t w, uint32_t h) {
+  using rex::graphics::draw_util::g_crashmom_diag_frame;
+  ++crashmom_diag_frame_number;
+  if (g_crashmom_diag_frame) {
+    REXGPU_INFO("DRAW-DIAG swap frontbuffer=0x{:08X} {}x{} (end of logged frame)",
+                frontbuffer_ptr, w, h);
+    g_crashmom_diag_frame = false;
+  }
+  int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::steady_clock::now() - crashmom_diag_t0)
+                       .count();
+  if (crashmom_diag_next < crashmom_diag_times.size() &&
+      now_ms >= crashmom_diag_times[crashmom_diag_next]) {
+    while (crashmom_diag_next < crashmom_diag_times.size() &&
+           now_ms >= crashmom_diag_times[crashmom_diag_next]) {
+      ++crashmom_diag_next;
+    }
+    REXGPU_INFO("DRAW-DIAG frame {} begins (t={} ms)", crashmom_diag_frame_number, now_ms);
+    g_crashmom_diag_frame = true;
+  }
+}
+}  // namespace
