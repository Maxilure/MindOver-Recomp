# =====================================================================
# NEVER commit anything that came off the disc, or anything generated
# from it. This repo must only contain OUR code + notes. Everyone who
# builds the port supplies their own legally-owned copy of the game.
# =====================================================================

# Disc images (the ISO you dumped from your own disc)
*.iso
*.xex
*.xexp

# Files extracted from the disc (see tools/xiso_extract.py)
/game/

# C++ generated by `rexglue codegen` from default.xex -- this IS the
# game's code (just translated), so it stays local only.
/generated/*
!/generated/rexglue.cmake

# Build output
/out/
/build/
CMakeUserPresets.json

# Local scratch / tool output
__pycache__/
*.pyc
/logs/

# Locally-built SDK install prefix (see docs/01-building.md)
/thirdparty/rexglue-install/
