# =====================================================================
# NEVER commit anything that came off the disc, or anything generated
# from it. This repo must only contain OUR code + notes. Everyone who
# builds the port supplies their own legally-owned copy of the game.
# =====================================================================

# Disc images (the ISO you dumped from your own disc)
*.iso
*.xex
*.xexp

# Files extracted from the disc (see tools/xiso_extract.py)
/game/

# C++ generated by `rexglue codegen` from default.xex -- this IS the
# game's code (just translated), so it stays local only.
/generated/*
!/generated/rexglue.cmake

# Build output
/out/
/build/
CMakeUserPresets.json

# F10 photos (tools/play.sh saves them in photos/): pictures of the game,
# kept local, not for the repo as they are.
/photos/

# Raw captures (--debug_capture_dir, the A/B tool: full-size game frames).
# The only game imagery in the repo is the few curated, compressed
# screenshots in docs/images/.
*.ppm

# Local scratch / tool output
__pycache__/
*.pyc
/logs/

# Locally-built SDK install prefix (see docs/01-building.md)
/thirdparty/rexglue-install/

# Local working notes (the AI assistant's CLAUDE.md, notes/), not part of
# the project.
/CLAUDE.md
/notes/

# The player's own files when the game runs from the source tree
# (src/game_folder.h): saves, settings, controls, photos, logs. Saves come
# from the game; settings are personal. Never in the repo.
/user/
# Shader cache + patched game data (rebuilt when missing).
/cache/
